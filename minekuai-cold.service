[Unit]
Description=Minekuai complete cold backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/minekuai-stop/venv/bin/python -B /opt/minekuai-stop/cold_backup.py run
StateDirectory=minekuai-cold
StateDirectoryMode=0700
UMask=0077
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/minekuai-stop
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=infinity
